# ══════════════════════════════════════════════════════════════════════════════
# SOP Chatbot — Runtime Configuration
# Copy this file to .env and edit as needed. Never commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Ollama ────────────────────────────────────────────────────────────────────
# When running locally (outside Docker): http://localhost:11434
# When running inside Docker Compose:    http://sop_ollama:11434
OLLAMA_BASE_URL=http://sop_ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:14b

# ── Data paths ────────────────────────────────────────────────────────────────
SCHEMA_DIR=./data_schema
EVERHEALTH_SOP_DIR=./data/Everhealth SOPs
OTHER_VERTICAL_SOP_DIR=./data/Other Vertical SOPs

# ── Feedback ──────────────────────────────────────────────────────────────────
FEEDBACK_FILE=./feedback.jsonl

# ── SOP Drop-folder Watcher (sop_watcher.py) ──────────────────────────────────
# Inbox folders watched by cron every 2 minutes on the server.
# Drop new SOP files here — they are auto-converted and loaded with zero downtime.
# Everhealth SOPs:       sop_inbox/everhealth/
# Other Vertical SOPs:   sop_inbox/other_vertical/
# Processed files:       sop_inbox/processed/
# Failed files:          sop_inbox/failed/
# Activity log:          sop_inbox/watcher.log
